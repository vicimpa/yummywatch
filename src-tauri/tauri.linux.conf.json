{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YummyWatch",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "backgroundColor": "#00000000",
        "theme": "Dark"
      }
    ]
  },
  "bundle": {
    "linux": {
      "appimage": { "bundleMediaFramework": true },
      "deb": {
        "depends": [
          "libmpv2",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": { "depends": ["mpv-libs", "gstreamer1-plugins-good", "gstreamer1-plugins-bad-free"] }
    }
  }
}
