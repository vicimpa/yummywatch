{
  "build": {
    "beforeDevCommand": "node scripts/prepare-windows-libmpv.mjs && npm run clean:tauri && npm run dev:web -- --port 4179 --strictPort",
    "beforeBuildCommand": "node scripts/prepare-windows-libmpv.mjs && npm run clean:tauri && npm run build:web"
  },
  "bundle": {
    "resources": {
      "native-libs/windows/libmpv-2.dll": "libmpv/libmpv-2.dll",
      "native-libs/windows/LICENSE.LGPL": "libmpv/LICENSE.LGPL",
      "native-libs/windows/SOURCE.txt": "libmpv/SOURCE.txt"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YummyWatch",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "backgroundColor": "#00000000",
        "theme": "Dark",
        "decorations": false,
        "shadow": true
      }
    ]
  }
}
