{
  "name": "yummywatch",
  "private": true,
  "version": "0.0.11",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "screenshots": "npm run build:web && cargo build --locked --manifest-path src-tauri/Cargo.toml --example media_probe && node scripts/screenshots.mjs",
    "check:player": "npm run check:player-ui",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "tsc -b && vite build",
    "tauri": "tauri",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:desktop-player": "cargo build --manifest-path src-tauri/Cargo.toml --example media_probe && node scripts/check-desktop-media.mjs",
    "check:player-ui": "cargo build --manifest-path src-tauri/Cargo.toml --example media_probe && node scripts/check-desktop-media.mjs --surface",
    "check:layout": "node scripts/check-layout.mjs",
    "check:keyboard": "node scripts/check-keyboard.mjs",
    "check:focus": "node scripts/check-focus.mjs",
    "check:virtual": "node scripts/check-virtual.mjs",
    "check:state": "npm run build:web && node scripts/check-state.mjs",
    "check:social": "npm run build:web && node scripts/check-social.mjs",
    "check:comments": "node scripts/check-comments.mjs",
    "check:ratings": "npm run build:web && node scripts/check-personal-ratings.mjs",
    "check:controls": "node scripts/check-player-controls.mjs",
    "check:app": "npm run build:web && cargo build --manifest-path src-tauri/Cargo.toml --example media_probe && node scripts/check-app.mjs",
    "check:cache": "npm run build:web && cargo build --manifest-path src-tauri/Cargo.toml --example media_probe && node scripts/check-app.mjs --cache",
    "clean:tauri": "node scripts/clean-tauri.mjs",
    "clean:tauri:check": "node scripts/clean-tauri.mjs --dry-run",
    "init:android": "node scripts/prepare-mobile.mjs android",
    "init:ios": "node scripts/prepare-mobile.mjs ios",
    "dev:android": "npm run init:android && node scripts/prepare-android-libmpv.mjs && tauri android dev",
    "dev:ios": "tauri ios dev",
    "build:android": "npm run init:android && node scripts/prepare-android-libmpv.mjs && tauri android build",
    "build:android:tv": "node scripts/build-android-tv.mjs",
    "build:ios": "tauri ios build",
    "check:mobile": "node scripts/check-mobile.mjs",
    "icons": "node scripts/icons.mjs",
    "check:playback-rate": "node scripts/check-playback-rate.mjs",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "preact": "^10.27.2",
    "shaka-player": "^5.3.5"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.10.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "prettier": "3.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  }
}
